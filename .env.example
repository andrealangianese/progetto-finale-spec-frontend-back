# Chiave per POST/PUT/DELETE (header "Authorization: Bearer <chiave>" o "X-API-Key").
# Obbligatoria in produzione: senza, le scritture rispondono 503.
# Generane una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Origini ammesse dal CORS, separate da virgola. Vuota = lettura pubblica da qualsiasi origine.
ALLOWED_ORIGINS=https://tuo-frontend.vercel.app,http://localhost:5173

# Rate limit opzionali (richieste per IP): letture al minuto, scritture ogni 15 minuti
# RATE_LIMIT_READ=300
# RATE_LIMIT_WRITE=30
