# Chiave per POST/PUT/DELETE (header "Authorization: Bearer <chiave>" o "X-API-Key").
# Obbligatoria in produzione: senza, le scritture rispondono 503.
# Generane una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Origini ammesse dal CORS, separate da virgola. Vuota = lettura pubblica da qualsiasi origine.
ALLOWED_ORIGINS=https://tuo-frontend.vercel.app,http://localhost:5173

# Rate limit opzionali (richieste per IP): letture al minuto, scritture ogni 15 minuti
# RATE_LIMIT_READ=300
# RATE_LIMIT_WRITE=30

# Storage persistente: imposta UNA sola tra MONGODB_URI e DATABASE_URL (entrambe = errore all'avvio).
# Nessuna = file JSON (in locale ok; su Vercel /tmp si azzera a ogni cold start).

# MongoDB (es. Atlas: con l'integrazione Vercel la variabile viene creata in automatico)
MONGODB_URI=
# Nome del database, se non è nell'URI (default: langiaroad)
# MONGODB_DB=langiaroad

# Postgres. Vuota = file JSON (in locale ok; su Vercel /tmp si azzera a ogni cold start).
# Esempio Neon: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Al primo avvio tabelle e dati iniziali (database/*.json) vengono creati automaticamente.
DATABASE_URL=

# Solo con un database: ogni quanti ms un'istanza ricarica la cache (consistenza tra istanze serverless)
# CACHE_TTL_MS=10000

# Solo per i test: server Postgres su cui creare database usa-e-getta
# TEST_DATABASE_URL=postgresql://user@localhost:5432/postgres
# TEST_MONGODB_URI=mongodb://localhost:27017
